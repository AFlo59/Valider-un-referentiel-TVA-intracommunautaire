# Copier en .env et adapter. Toutes les valeurs ont un défaut.

# --- PostgreSQL (kit : port hôte 5435, pas 5432). 127.0.0.1 plutôt que localhost : sous Windows, localhost se résout d'abord en ::1 et peut passer par un relais WSL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=tva
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian

# --- VIES ---
# Endpoint REST documenté (POST). Le lien GET du brief est l'endpoint privé de l'interface web : non utilisé.
VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number
VIES_STATUS_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-status
# Délai maximal d'attente d'une réponse (mesuré : 0,1 s pour un numéro faux, 6 à 8 s pour un numéro valide)
VIES_TIMEOUT=30
# Temporisation entre deux appels pendant une campagne, en secondes (un seul appel à la fois : la limite VIES est globale par État)
VIES_DELAY=1.5
# Numéro de TVA de Meridian Distribution (demandeur) : sans lui VIES ne renvoie pas de numéro de consultation (requestIdentifier),
# qui est la preuve à conserver pour l'administration. Laisser vide si inconnu.
VIES_REQUESTER_COUNTRY=
VIES_REQUESTER_NUMBER=
# Durée pendant laquelle un verdict VIES est considéré frais par l'API, en heures
VERDICT_TTL_HOURS=24
# Mettre 1 si votre poste intercepte le TLS (proxy d'entreprise, antivirus)
NATIVE_TLS=0

# --- Fichiers ---
DATA_FILE=data/numeros_tva.csv
REPORT_FILE=docs/rapport-reconciliation.md
